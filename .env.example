# ============================================================
# Alpha Marketing Studio — variables d'environnement
#
# Copiez ce fichier en `.env.local` pour le développement.
# En production, saisissez les mêmes clés dans Vercel :
#   Project → Settings → Environment Variables
#
# `.env.local` est ignoré par git et ne doit JAMAIS être commité.
# Les variables préfixées NEXT_PUBLIC_ sont visibles dans le
# navigateur : n'y mettez jamais une clé secrète.
# ============================================================


# ---- Infolettre : Brevo -------------------------------------
# https://app.brevo.com/settings/keys/api
# Sans ces deux valeurs, les inscriptions sont seulement écrites
# dans les journaux du serveur et le site continue de fonctionner.
BREVO_API_KEY=
# Contacts → Listes → l'identifiant numérique de la liste
BREVO_LIST_ID=

# Double opt-in (obligatoire pour la LCAP).
# Campagnes → Modèles → créez un modèle de confirmation, puis
# reportez son identifiant numérique ici.
BREVO_DOI_TEMPLATE_ID=
# Page où la personne arrive après avoir cliqué dans le courriel
BREVO_DOI_REDIRECT_URL=https://www.alphamarketingstudio.com/merci


# ---- Formulaire de contact : Resend -------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Doit être une adresse d'un domaine vérifié dans Resend.
# Exemple : "Alpha Marketing Studio <site@alphamarketingstudio.com>"
CONTACT_FROM_EMAIL=


# ---- Anti-robot : Cloudflare Turnstile ----------------------
# https://dash.cloudflare.com → Turnstile → Add site
# Gratuit, sans témoin de suivi.
# Si ces deux valeurs sont absentes, le widget ne s'affiche pas et
# la vérification est ignorée ; le pot-de-miel et la limitation de
# débit restent actifs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ---- Mesure d'audience (facultatif) -------------------------
# Ces scripts ne sont chargés QU'APRÈS acceptation de la bannière
# de consentement. Laissez vide tant que vous n'en avez pas besoin.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
